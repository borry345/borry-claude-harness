      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./env.js)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git tag:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(yarn add:*)",
      "Bash(pnpm add:*)",
      "Bash(git rm:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)"
    ],
    "allow": [
      "Bash(sh scripts/checkpoint-commit.sh:*)",
      "Bash(bash scripts/checkpoint-commit.sh:*)",
      "Bash(scripts/checkpoint-commit.sh:*)"
    ]
  }
}
